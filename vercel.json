{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/api/[...path].ts?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api(?:/|$)).*$",
      "dest": "/index.html"
    }
  ]
}
