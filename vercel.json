{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "^/api/tasks/([^/]+)$",
      "dest": "/api/tasks/[id]?id=$1"
    },
    {
      "src": "^/api/tasks$",
      "dest": "/api/tasks/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
